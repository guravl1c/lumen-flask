<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Детектор взрыва мозга</title>
<HTA:APPLICATION
  ID="Launcher"
  APPLICATIONNAME="Детектор взрыва мозга"
  BORDER="thin"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="normal"
  INNERBORDER="no"
  SCROLL="yes"
  MAXIMIZEBUTTON="no"
/>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 0;
    font-family: "Segoe UI", Tahoma, sans-serif;
    background: #0a0d1a;
    color: #eaeaf0;
    user-select: none;
    overflow-x: hidden;
  }

  .window {
    padding: 26px 30px;
    min-height: 640px;
  }

  /* ---------- Шапка ---------- */
  .hero {
    margin-bottom: 22px;
    display: table;
    width: 100%;
  }
  .hero-icon {
    display: table-cell;
    vertical-align: middle;
    width: 64px;
  }
  .hero-icon-inner {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: #7b3cff;
    display: inline-block;
    text-align: center;
    line-height: 56px;
    font-size: 30px;
    box-shadow: 0 6px 18px rgba(123, 60, 255, 0.5);
  }
  .hero-text {
    display: table-cell;
    vertical-align: middle;
    padding-left: 14px;
  }
  .hero-text h1 {
    margin: 0 0 2px;
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.3px;
  }
  .hero-text p {
    margin: 0;
    font-size: 13px;
    color: #8a92b0;
  }

  /* ---------- Кнопки ---------- */
  .buttons { margin-bottom: 16px; }
  .btn-row { margin-bottom: 10px; }

  button {
    padding: 14px 18px;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    color: #ffffff;
    letter-spacing: 0.2px;
    display: inline-block;
    vertical-align: middle;
  }
  button:disabled { opacity: 0.35; cursor: default; }

  .btn-full {
    display: block;
    width: 100%;
    text-align: center;
  }
  .btn-half {
    width: 48.5%;
    text-align: center;
    margin-right: 2.5%;
  }
  .btn-half-last {
    width: 48.5%;
    text-align: center;
    margin-right: 0;
  }

  .btn-start {
    background: #3b6cff;
    font-size: 17px;
    padding: 18px 20px;
    box-shadow: 0 6px 18px rgba(59, 108, 255, 0.45);
  }
  .btn-stop { background: #5f3a52; }
  .btn-diag { background: #2a5f4a; }
  .btn-hardstop {
    background: #7a1f3a;
    width: 100%;
    display: block;
    text-align: center;
  }

  /* ---------- Статус ---------- */
  .status {
    padding: 12px 16px;
    background: #1a1f38;
    border-radius: 12px;
    font-size: 14px;
    margin-bottom: 14px;
    border-left: 4px solid #3b6cff;
    color: #eaeaf0;
  }
  .status.running {
    border-left-color: #2ecc71;
    background: #0e2a1a;
    color: #7dffb0;
  }
  .status.error {
    border-left-color: #e74c3c;
    background: #2a0a06;
    color: #ff8a7a;
  }

  /* ---------- Прогресс ---------- */
  .progress {
    height: 8px;
    background: #1a1f38;
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 18px;
    display: none;
  }
  .progress.show { display: block; }
  .progress-bar {
    height: 100%;
    background: #3b6cff;
    width: 0%;
    transition: width .4s;
  }

  /* ---------- Шаги ---------- */
  .steps {
    margin-bottom: 20px;
    display: table;
    width: 100%;
    table-layout: fixed;
    border-spacing: 6px 0;
  }
  .step {
    display: table-cell;
    padding: 12px 6px;
    background: #1a1f38;
    border-radius: 12px;
    border: 1px solid #2a2f4a;
    text-align: center;
    font-size: 12px;
    color: #6a7290;
    vertical-align: middle;
    width: 25%;
  }
  .step .icon {
    display: block;
    font-size: 20px;
    margin-bottom: 4px;
  }
  .step.active {
    color: #ffffff;
    border-color: #3b6cff;
    background: #1a2548;
  }
  .step.done {
    color: #2ecc71;
    border-color: #2ecc71;
    background: #0e2a1a;
  }

  /* ---------- Ссылки ---------- */
  .links-section { display: none; margin-bottom: 14px; }
  .links-section.show { display: block; }

  .link-card {
    padding: 14px 16px;
    background: #1a1f38;
    border-radius: 14px;
    border: 1px solid #3b6cff;
    margin-bottom: 10px;
  }
  .link-card.cloudpub { border-color: #7b3cff; background: #1e1a38; }
  .link-card.ngrok { border-color: #3b6cff; }
  .link-card.local { border-color: #2ecc71; background: #0e2a1a; }

  .link-header {
    margin-bottom: 8px;
  }
  .link-badge {
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 700;
    letter-spacing: 0.5px;
    display: inline-block;
    vertical-align: middle;
    margin-right: 8px;
  }
  .link-badge.cloudpub { background: #7b3cff; color: #ffffff; }
  .link-badge.ngrok { background: #3b6cff; color: #ffffff; }
  .link-badge.local { background: #2ecc71; color: #06210f; }

  .link-title {
    font-size: 13px;
    font-weight: 700;
    color: #eaeaf0;
    display: inline-block;
    vertical-align: middle;
  }
  .link-sub {
    font-size: 11px;
    color: #8a92b0;
    display: inline-block;
    vertical-align: middle;
    margin-left: 8px;
  }

  .link-url {
    font-size: 12px;
    font-family: Consolas, monospace;
    word-break: break-all;
    margin-bottom: 10px;
    padding: 8px 10px;
    background: #0a0d1a;
    border-radius: 8px;
    color: #b19dff;
  }
  .link-card.ngrok .link-url { color: #7d9dff; }
  .link-card.local .link-url { color: #7dffb0; }

  .link-actions { }

  .btn-copy, .btn-open {
    padding: 8px 14px;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    display: inline-block;
    margin-right: 6px;
  }
  .btn-copy {
    background: #2a2f4a;
    color: #eaeaf0;
    border: 1px solid #3b6cff;
  }
  .btn-open {
    background: #2ecc71;
    color: #06210f;
  }

  /* ---------- Футер ---------- */
  .footer {
    text-align: center;
    font-size: 11px;
    color: #4a5070;
    padding-top: 18px;
  }
</style>
<script language="VBScript">
Dim WshShell, ProjectDir, NgrokPath, CloPath
Dim CloudPubUrl, NgrokUrl, LocalUrl

Set WshShell = CreateObject("WScript.Shell")
ProjectDir = "C:\Users\Ольга\Desktop\BrainDetector"
NgrokPath  = "C:\Users\Ольга\Desktop\ngrok\ngrok.exe"
CloPath    = "C:\Users\Ольга\Desktop\BrainDetector\clo.exe"

CloudPubUrl = "https://huskily-compelling-primate.cloudpub.ru"
NgrokUrl    = "https://knoll-dumpling-reputable.ngrok-free.dev"
LocalUrl    = ""

Function GetLocalAddress()
  Dim exec, output, lines, i, line, pos, ip
  GetLocalAddress = ""
  On Error Resume Next
  Set exec = WshShell.Exec("cmd /c ipconfig")
  output = exec.StdOut.ReadAll()
  lines = Split(output, vbCrLf)
  For i = 0 To UBound(lines)
    line = Trim(lines(i))
    If InStr(line, "IPv4") > 0 Then
      pos = InStr(line, ":")
      If pos > 0 Then
        ip = Trim(Mid(line, pos + 1))
        If InStr(ip, "192.168.") > 0 Or InStr(ip, "10.") > 0 Then
          GetLocalAddress = "http://" & ip & ":5000"
          Exit Function
        End If
      End If
    End If
  Next
End Function

Sub StartApp
  On Error Resume Next
  Err.Clear

  document.getElementById("btn-start").disabled = true
  document.getElementById("btn-stop").disabled = false
  Call SetStatus("Запускаю приложение...", "running")
  document.getElementById("progress").className = "progress show"
  Call SetProgress(5)
  Call SetStep(1, "active")

  WshShell.Run "cmd /c cd /d """ & ProjectDir & """ && python app.py", 0, False
  WScript.Sleep 3000
  Call SetStep(1, "done")
  Call SetProgress(30)
  Call SetStep(2, "active")

  WshShell.Run "cmd /c cd /d """ & ProjectDir & """ && clo.exe publish http 5000", 0, False
  WScript.Sleep 3000
  Call SetStep(2, "done")
  Call SetProgress(60)
  Call SetStep(3, "active")

  WshShell.Run """" & NgrokPath & """ http 5000", 0, False
  WScript.Sleep 3000
  Call SetStep(3, "done")
  Call SetProgress(85)
  Call SetStep(4, "active")

  LocalUrl = GetLocalAddress()

  WshShell.Run "cmd /c echo " & CloudPubUrl & "| clip", 0, True

  WshShell.Run CloudPubUrl & "/teacher", 1, False
  Call SetStep(4, "done")
  Call SetProgress(100)

  document.getElementById("link-cloudpub-text").innerText = CloudPubUrl
  document.getElementById("link-ngrok-text").innerText = NgrokUrl
  If LocalUrl <> "" Then
    document.getElementById("link-local-text").innerText = LocalUrl
    document.getElementById("link-local-card").style.display = "block"
  End If
  document.getElementById("links-section").className = "links-section show"

  Call SetStatus("Всё запущено! CloudPub-ссылка в буфере обмена.", "running")
End Sub

Sub StopApp
  On Error Resume Next
  Err.Clear
  Call SetStatus("Останавливаю...", "")
  document.getElementById("btn-stop").disabled = true

  WshShell.Run "cmd /c taskkill /IM ngrok.exe /F", 0, True
  WshShell.Run "cmd /c taskkill /IM clo.exe /F", 0, True
  WshShell.Run "cmd /c for /f ""tokens=5"" %a in ('netstat -aon ^| findstr :5000') do taskkill /F /PID %a", 0, True

  document.getElementById("btn-start").disabled = false
  document.getElementById("links-section").className = "links-section"
  document.getElementById("progress").className = "progress"
  Call SetProgress(0)
  Call SetStep(1, "")
  Call SetStep(2, "")
  Call SetStep(3, "")
  Call SetStep(4, "")
  Call SetStatus("Остановлено.", "")
End Sub

Sub HardStop
  On Error Resume Next
  Err.Clear
  Call SetStatus("Жёсткая остановка...", "")
  document.getElementById("btn-start").disabled = false
  document.getElementById("btn-stop").disabled = true

  WshShell.Run "cmd /c taskkill /IM ngrok.exe /F", 0, True
  WshShell.Run "cmd /c taskkill /IM clo.exe /F", 0, True
  WshShell.Run "cmd /c taskkill /IM python.exe /F", 0, True

  document.getElementById("links-section").className = "links-section"
  document.getElementById("progress").className = "progress"
  Call SetProgress(0)
  Call SetStep(1, "")
  Call SetStep(2, "")
  Call SetStep(3, "")
  Call SetStep(4, "")
  Call SetStatus("Всё убито жёстко.", "")
End Sub

Sub CopyCloudPub
  WshShell.Run "cmd /c echo " & CloudPubUrl & "| clip", 0, True
  Call SetStatus("CloudPub-ссылка скопирована.", "running")
End Sub

Sub CopyNgrok
  WshShell.Run "cmd /c echo " & NgrokUrl & "| clip", 0, True
  Call SetStatus("Ngrok-ссылка скопирована.", "running")
End Sub

Sub CopyLocal
  If LocalUrl <> "" Then
    WshShell.Run "cmd /c echo " & LocalUrl & "| clip", 0, True
    Call SetStatus("Локальная ссылка скопирована.", "running")
  End If
End Sub

Sub OpenStudentCloudPub
  WshShell.Run CloudPubUrl & "/student", 1, False
End Sub

Sub OpenDiagnostics
  WshShell.Run "http://localhost:5000/diagnostics", 1, False
End Sub

Sub SetStatus(text, cls)
  On Error Resume Next
  Dim el
  Set el = document.getElementById("status")
  If Not el Is Nothing Then
    el.innerText = text
    el.className = "status " & cls
  End If
End Sub

Sub SetProgress(percent)
  On Error Resume Next
  Dim el
  Set el = document.getElementById("progress-bar")
  If Not el Is Nothing Then el.style.width = percent & "%"
End Sub

Sub SetStep(num, state)
  On Error Resume Next
  Dim el
  Set el = document.getElementById("step-" & num)
  If Not el Is Nothing Then
    If state = "done" Then
      el.className = "step done"
    ElseIf state = "active" Then
      el.className = "step active"
    Else
      el.className = "step"
    End If
  End If
End Sub
</script>
</head>
<body>
<div class="window">

  <!-- Hero -->
  <div class="hero">
    <div class="hero-icon">
      <div class="hero-icon-inner">🧠</div>
    </div>
    <div class="hero-text">
      <h1>Детектор взрыва мозга</h1>
      <p>Формирующее оценивание в реальном времени</p>
    </div>
  </div>

  <!-- Кнопки -->
  <div class="buttons">
    <div class="btn-row">
      <button id="btn-start" class="btn-start btn-full" onclick="StartApp">▶  Запустить приложение</button>
    </div>
    <div class="btn-row">
      <button id="btn-stop" class="btn-stop btn-half" onclick="StopApp" disabled>⏹  Остановить</button>
      <button class="btn-diag btn-half-last" onclick="OpenDiagnostics">📡  Диагностика</button>
    </div>
    <div class="btn-row">
      <button class="btn-hardstop" onclick="HardStop">💀  Жёсткая остановка (если зависло)</button>
    </div>
  </div>

  <!-- Статус -->
  <div id="status" class="status">Готово к запуску.</div>

  <!-- Прогресс -->
  <div id="progress" class="progress">
    <div id="progress-bar" class="progress-bar"></div>
  </div>

  <!-- Шаги -->
  <div class="steps">
    <div id="step-1" class="step"><span class="icon">🐍</span>Flask</div>
    <div id="step-2" class="step"><span class="icon">🚀</span>CloudPub</div>
    <div id="step-3" class="step"><span class="icon">🌍</span>Ngrok</div>
    <div id="step-4" class="step"><span class="icon">🌐</span>Браузер</div>
  </div>

  <!-- Ссылки -->
  <div id="links-section" class="links-section">

    <div class="link-card cloudpub">
      <div class="link-header">
        <span class="link-badge cloudpub">ОСНОВНОЙ</span>
        <span class="link-title">CloudPub</span>
        <span class="link-sub">без VPN · из любой сети</span>
      </div>
      <div id="link-cloudpub-text" class="link-url"></div>
      <div class="link-actions">
        <button class="btn-copy" onclick="CopyCloudPub">📋  Копировать</button>
        <button class="btn-open" onclick="OpenStudentCloudPub">🎓  Открыть ученика</button>
      </div>
    </div>

    <div class="link-card ngrok">
      <div class="link-header">
        <span class="link-badge ngrok">РЕЗЕРВ</span>
        <span class="link-title">Ngrok</span>
        <span class="link-sub">требует VPN</span>
      </div>
      <div id="link-ngrok-text" class="link-url"></div>
      <div class="link-actions">
        <button class="btn-copy" onclick="CopyNgrok">📋  Копировать</button>
      </div>
    </div>

    <div id="link-local-card" class="link-card local" style="display:none;">
      <div class="link-header">
        <span class="link-badge local">КЛАСС</span>
        <span class="link-title">Локальная сеть</span>
        <span class="link-sub">без интернета</span>
      </div>
      <div id="link-local-text" class="link-url"></div>
      <div class="link-actions">
        <button class="btn-copy" onclick="CopyLocal">📋  Копировать</button>
      </div>
    </div>

  </div>

  <div class="footer">
    v3.0 &nbsp;·&nbsp; Flask + Socket.IO &nbsp;·&nbsp; CloudPub + Ngrok
  </div>

</div>
</body>
</html>